{
  "name": "smart-wallet",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "prettier:sol": "prettier --write --plugin=prettier-plugin-solidity 'src/**/*.sol' 'test/**/*.sol'",
    "prettier:solhint": "solhint 'src/**/*.sol' 'test/**/*.sol' --fix --noPrompt",
    "prettier:check": "prettier --check --plugin=prettier-plugin-solidity 'src/**/*.sol' 'test/**/*.sol'",
    "update-recovery": "git submodule update --remote --merge lib/smart-wallet-recovery",
    "cloc": "npx cloc src test --exclude-dir=mocks,test",
    "coverage": "forge coverage --report lcov && genhtml -o coverage_report lcov.info --ignore-errors inconsistent && open coverage_report/index.html",
    "build": "forge clean && forge build src script",
    "test": "forge test && yarn smoke-test",
    "deploy": "forge script script/deploy/DeployInit.s.sol --rpc-url",
    "deploy-factory": "forge script script/deploy/DeploySingletonFactory.s.sol:DeploySingletonFactory --rpc-url",
    "smoke-test": "bash script/smoke_test/test-local.sh",
    "0-createAccount": "forge script script/smoke_test/0-createAccount.s.sol --rpc-url",
    "1-setCodeAndInitialize": "forge script script/smoke_test/1-setCodeAndInitialize.s.sol --rpc-url",
    "2-sendTxs": "forge script script/smoke_test/2-sendTxs.s.sol --rpc-url",
    "3-sendTxsAsRelayer": "forge script script/smoke_test/3-sendTxsAsRelayer.s.sol --rpc-url",
    "4-sendTxsWithPasskey": "forge script script/smoke_test/4-sendTxsWithPasskey.s.sol --rpc-url",
    "5-createAccountWithAddOwner": "forge script script/smoke_test/5-createAccountWithAddOwner.s.sol --rpc-url",
    "6-addOwnerAndExecuteViaEntryPoint": "forge script script/smoke_test/6-addOwnerAndExecuteViaEntryPoint.s.sol --rpc-url",
    "code": "cast code",
    "test-relayer": "npx mocha tests/RelayerFlow.t.ts --require ts-node/register --timeout 120000"
  },
  "pre-commit": [
    "prettier:sol",
    "update-recovery"
  ],
  "dependencies": {
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "ethereumjs-util": "^7.1.5",
    "prettier": "^3.1.0",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^4.1.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-foundry": "^1.2.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.10",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.10",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.13",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "cloc": "^2.4.0-cloc",
    "ec-pem": "^0.18.0",
    "ethers": "^6.15.0",
    "hardhat": "^2.22.10",
    "hardhat-gas-reporter": "^2.2.2",
    "pre-commit": "^1.2.2",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.25.0"
  }
}
