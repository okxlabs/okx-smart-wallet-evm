{
  "name": "smart-wallet",
  "version": "2.0.0",
  "packageManager": "yarn@1.22.19",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "prettier:sol": "prettier --write --plugin=prettier-plugin-solidity 'src/**/*.sol' 'test/**/*.sol'",
    "prettier:solhint": "solhint 'src/**/*.sol' 'test/**/*.sol' --fix --noPrompt",
    "prettier:check": "prettier --check --plugin=prettier-plugin-solidity 'src/**/*.sol' 'test/**/*.sol'",
    "cloc": "npx cloc src test --exclude-dir=mocks,test",
    "coverage": "forge coverage --report lcov && genhtml -o coverage_report lcov.info --ignore-errors inconsistent && open coverage_report/index.html",
    "build": "forge clean && forge build src script",
    "test": "forge test",
    "deploy": "forge script script/deploy.s.sol:DeployInit --rpc-url",
    "deploy:broadcast": "forge script script/deploy.s.sol:DeployInit --broadcast --skip-simulation --rpc-url",
    "code": "cast code"
  },
  "pre-commit": [
    "prettier:sol"
  ],
  "dependencies": {
    "axios": "1.11.0",
    "dotenv": "17.2.1",
    "ethereumjs-util": "7.1.5",
    "prettier": "3.5.2",
    "prettier-plugin-solidity": "1.4.2",
    "solhint": "4.5.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@nomicfoundation/hardhat-foundry": "1.2.0",
    "@nomicfoundation/hardhat-ignition": "0.15.13",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.14",
    "@nomicfoundation/hardhat-network-helpers": "1.0.12",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-verify": "2.1.1",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/mocha": "10.0.10",
    "chai": "4.5.0",
    "cloc": "2.11.0",
    "ec-pem": "0.18.0",
    "ethers": "6.15.0",
    "hardhat": "2.26.3",
    "hardhat-gas-reporter": "2.3.0",
    "pre-commit": "1.2.2",
    "solidity-coverage": "0.8.14",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.39.1"
  }
}
