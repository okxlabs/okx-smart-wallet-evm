pragma solidity ^0.8.26;

import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";

/* Mock of malicous token which may launch an attack to relayer */
contract MockMaliciousERC20 is ERC20 {
    uint256 gasDrainingAttackHeight;
    uint256 largeBlobAttackHeight;

    constructor(
        uint256 gasDrainingHeight,
        uint256 largeBlobHeight
    ) ERC20("MaliciousToken", "ATK") {
        _mint(msg.sender, 1000 ether);
        gasDrainingAttackHeight = gasDrainingHeight;
        largeBlobAttackHeight = largeBlobHeight;
    }

    function getDrainingAttackHeight() public view returns (uint256) {
        return gasDrainingAttackHeight;
    }

    function getLargeBlobAttackHeight() public view returns (uint256) {
        return largeBlobAttackHeight;
    }

    function transfer(
        address to,
        uint256 value
    ) public override returns (bool) {
        if (block.number == gasDrainingAttackHeight) {
            while (true) {}
        } else if (block.number == largeBlobAttackHeight) {
            revert(
                ""
            );
        }
        address owner = _msgSender();
        _transfer(owner, to, value);
        return true;
    }
}
